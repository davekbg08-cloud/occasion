{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "database": {
      "port": 9000
    }
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "occasion-10cdb",
          "appId": "1:101610899328:android:8145ca9b4fbab568486365",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "occasion-10cdb",
          "configurations": {
            "android": "1:101610899328:android:8145ca9b4fbab568486365",
            "ios": "1:101610899328:ios:1ef95a310386d06c486365",
            "web": "1:101610899328:web:94ef5e76085b599b486365"
          }
        }
      }
    }
  }
}
