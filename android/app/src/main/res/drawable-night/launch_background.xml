<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de démarrage en mode sombre : fond sombre de l'app et logo clair
     (drawable-night-nodpi/splash_logo). Mode clair : drawable[-v21]. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#0F1720" />
    </item>

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
