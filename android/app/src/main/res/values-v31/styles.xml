<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+ : écran de démarrage système sur fond blanc (celui
             du logo, qui s'y fond sans cadre), logo entier (voir
             drawable/splash_icon) — même rendu que le premier écran de
             chargement de l'app qui lui succède. -->
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- Sans ça, Android (API 29+, systématique à partir d'Android 15 en
             mode edge-to-edge) dessine lui-même un bandeau de contraste
             semi-transparent par-dessus la barre de statut/navigation dès
             que du contenu est visible derrière elles — quelle que soit la
             couleur demandée côté Flutter (SystemUiOverlayStyle). Ignoré
             silencieusement sur les versions d'Android antérieures à l'API
             29, qui ne connaissent pas ces attributs. -->
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
