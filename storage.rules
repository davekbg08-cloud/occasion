rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource != null
        && request.resource.contentType.matches('video/.*');
    }

    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && isImage()
        && request.resource.size <= 3 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    match /annonces/{sellerId}/{annonceId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(sellerId)
        && (
          (isImage() && request.resource.size <= 5 * 1024 * 1024)
          || (isVideo() && request.resource.size <= 50 * 1024 * 1024)
        );
      allow delete: if isOwner(sellerId);
    }

    match /verification/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isImage()
        && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // Photos/vidéos envoyées dans une conversation : privées aux deux
    // participants (jamais publiques, contrairement à `annonces`/`profiles`).
    // Les deux participants sont encodés directement dans le chemin
    // (`{buyerOrSender}/{sellerOrReceiver}`, voir
    // `ChatMediaUploadService.upload`) plutôt que résolus via une lecture
    // Firestore croisée (`firestore.get`) depuis les règles Storage :
    // cette dernière approche s'est avérée systématiquement en échec
    // (`unauthorized`) en production sur ce projet malgré une syntaxe
    // conforme à la documentation — encoder l'autorisation dans le chemin
    // lui-même évite complètement cette dépendance fragile. Immuable une
    // fois envoyé (aucun `update`), comme les messages eux-mêmes.
    match /chatMedia/{chatId}/{userA}/{userB}/{fileName} {
      allow read: if signedIn()
        && (request.auth.uid == userA || request.auth.uid == userB);
      allow create: if signedIn()
        && (request.auth.uid == userA || request.auth.uid == userB)
        && (
          (isImage() && request.resource.size <= 5 * 1024 * 1024)
          || (isVideo() && request.resource.size <= 25 * 1024 * 1024)
        );
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
