rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource != null
        && request.resource.contentType.matches('video/.*');
    }

    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && isImage()
        && request.resource.size <= 3 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    match /annonces/{sellerId}/{annonceId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(sellerId)
        && (
          (isImage() && request.resource.size <= 5 * 1024 * 1024)
          || (isVideo() && request.resource.size <= 50 * 1024 * 1024)
        );
      allow delete: if isOwner(sellerId);
    }

    match /verification/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isImage()
        && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // Photos/vidéos envoyées dans une conversation : privées aux deux
    // participants (jamais publiques, contrairement à `annonces`/`profiles`).
    // `isChatParticipant` interroge Firestore pour vérifier que l'appelant
    // est bien acheteur ou vendeur de CE chat — même principe que la
    // fonction homonyme de `firestore.rules`. Immuable une fois envoyé
    // (aucun `update`), comme les messages eux-mêmes.
    function isChatParticipant(chatId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && (
          firestore.get(/databases/(default)/documents/chats/$(chatId)).data.buyerId == request.auth.uid
          || firestore.get(/databases/(default)/documents/chats/$(chatId)).data.sellerId == request.auth.uid
        );
    }

    match /chatMedia/{chatId}/{fileName} {
      allow read: if isChatParticipant(chatId);
      allow create: if isChatParticipant(chatId)
        && (
          (isImage() && request.resource.size <= 5 * 1024 * 1024)
          || (isVideo() && request.resource.size <= 25 * 1024 * 1024)
        );
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
